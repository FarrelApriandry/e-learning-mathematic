---
const { level } = Astro.props;
---

<section class="container mx-auto px-4 py-10">
  <div class="bg-white/80 backdrop-blur-xl rounded-3xl shadow-2xl p-8 max-w-2xl mx-auto border border-indigo-100">
    <header class="mb-6 text-center">
      <h1 class="text-3xl font-bold text-indigo-700 drop-shadow-sm">Quiz Aljabar</h1>
      <p class="text-slate-600 mt-1">Level {level}</p>
    </header>

    <!-- Progress -->
    <div class="mb-6">
      <div class="w-full bg-slate-200 rounded-full h-2.5">
        <div class="bg-indigo-500 h-2.5 rounded-full w-[20%] transition-all duration-300"></div>
      </div>
      <p class="text-xs text-slate-500 mt-1 text-right">1 dari 5 soal</p>
    </div>

    <!-- Question -->
    <div class="bg-white rounded-2xl shadow-sm p-6 mb-6">
      <h2 class="text-lg font-semibold mb-4 text-gray-800">
        Jika x + 3 = 7, maka x = ?
      </h2>

      <div class="space-y-3">
        <button class="w-full px-4 py-2 border border-gray-300 rounded-xl text-left hover:bg-indigo-50 hover:border-indigo-400 transition">3</button>
        <button class="w-full px-4 py-2 border border-gray-300 rounded-xl text-left hover:bg-indigo-50 hover:border-indigo-400 transition">4</button>
        <button class="w-full px-4 py-2 border border-gray-300 rounded-xl text-left hover:bg-indigo-50 hover:border-indigo-400 transition">5</button>
        <button class="w-full px-4 py-2 border border-gray-300 rounded-xl text-left hover:bg-indigo-50 hover:border-indigo-400 transition">6</button>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center">
      <button class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-2 rounded-full transition shadow">
        Next ➜
      </button>
    </div>
  </div>
</section>
