---
---
<nav class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-md">
  <div class="container mx-auto px-4 md:px-6">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2.5">
        <img src="/icon.svg" class="h-9 w-9" alt="Logo Asyik Math" width="36" height="36" />
        <div class="leading-tight">
          <div class="text-sm font-extrabold tracking-tight text-slate-900">Asyik Math</div>
          <div class="text-[11px] font-medium text-slate-500">Matematika SMA</div>
        </div>
      </a>

      <!-- Desktop links -->
      <div class="hidden md:flex items-center gap-1 text-sm font-medium">
        <a href="/materi/" class="rounded-lg px-3.5 py-2 text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">Materi</a>
        <a href="/quiz/" class="rounded-lg px-3.5 py-2 text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">Quiz</a>
        <a href="/about" class="rounded-lg px-3.5 py-2 text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition">Tentang</a>
        <a href="/materi/" class="ml-2 rounded-xl bg-indigo-600 px-4.5 px-5 py-2.5 font-semibold text-white hover:bg-indigo-700 transition">Mulai Belajar</a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button id="nav-toggle" aria-expanded="false" aria-controls="mobile-menu" class="rounded-lg p-2 hover:bg-slate-100">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden">
      <div class="flex flex-col gap-1 border-t border-slate-100 py-3 text-sm font-medium">
        <a href="/materi/" class="rounded-lg px-3 py-2.5 text-slate-700 hover:bg-slate-100">Materi</a>
        <a href="/quiz/" class="rounded-lg px-3 py-2.5 text-slate-700 hover:bg-slate-100">Quiz</a>
        <a href="/about" class="rounded-lg px-3 py-2.5 text-slate-700 hover:bg-slate-100">Tentang</a>
        <a href="/materi/" class="mt-1 rounded-xl bg-indigo-600 px-4 py-2.5 text-center font-semibold text-white">Mulai Belajar</a>
      </div>
    </div>
  </div>

  <script type="module">
    const btn = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        menu.classList.toggle('hidden');
      });
    }
  </script>
</nav>
