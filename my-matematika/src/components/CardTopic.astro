---
const { title, description, link } = Astro.props;
---

<a 
  href={link} 
  class="block bg-white rounded-xl p-6 border border-transparent shadow-md
    transition-all duration-300 ease-out hover:-translate-y-2 hover:scale-[1.02] hover:shadow-xl card
  hover:border-blue-100 hover:bg-gradient-to-br from-white to-blue-50/40"
>
  <h2 class="text-lg font-semibold text-slate-800 group-hover:text-blue-600 transition-colors">
    {title}
  </h2>
  <p class="text-gray-500 text-sm mt-2">{description}</p>
</a>

<!-- <a href={link} class="card">
  <h2 class="text-lg font-semibold text-slate-800 transition-colors group-hover:text-blue-600">
    {title}
  </h2>
  <p class="text-gray-500 text-sm mt-2">{description}</p>
</a> -->

<style>
  /* optional: soft entrance animation */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  a {
    animation: fadeUp 0.5s ease forwards;
  }
</style>
