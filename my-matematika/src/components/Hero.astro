---
const {
  heading = 'Asyik Math',
  second_heading = 'E-Learning',
  sub = 'Video pembelajaran dan quiz interaktif matematika SMA — terstruktur per kelas, dengan pembahasan yang fokus ke pemahaman konsep.',
  ctaText = 'Mulai Belajar',
  ctaHref = '/materi/',
  stats = { materi: 0, quiz: 0 },
} = Astro.props;
---
<section class="relative overflow-hidden bg-slate-50">
  <!-- pola grid halus -->
  <div class="absolute inset-0" style="background-image: linear-gradient(to right, rgb(15 23 42 / 0.04) 1px, transparent 1px), linear-gradient(to bottom, rgb(15 23 42 / 0.04) 1px, transparent 1px); background-size: 44px 44px; mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, black 55%, transparent 100%);"></div>

  <div class="container mx-auto px-4 md:px-6 py-16 md:py-24 relative">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- KIRI -->
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-3.5 py-1.5 text-xs font-semibold text-indigo-700">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          Matematika SMA &bull; Kelas 10&ndash;12
        </span>

        <h1 class="mt-5 text-4xl md:text-5xl font-extrabold leading-[1.1] tracking-tight text-slate-900">
          {heading} <span class="text-indigo-600">{second_heading}</span><span aria-hidden="true" class="ml-1 inline-block h-2.5 w-2.5 rounded-full bg-amber-400 align-super"></span>
        </h1>

        <p class="mt-4 text-base md:text-lg text-slate-600 max-w-xl leading-relaxed">
          {sub}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={ctaHref} class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition">
            {ctaText}
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/quiz/" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:border-slate-400 hover:bg-slate-50 transition">
            Lihat Quiz
          </a>
        </div>

        <dl class="mt-10 flex items-center gap-8 border-t border-slate-200 pt-6">
          <div>
            <dt class="text-2xl font-extrabold text-slate-900">{stats.materi}</dt>
            <dd class="mt-0.5 text-xs font-medium text-slate-500">Materi</dd>
          </div>
          <div class="h-10 w-px bg-slate-200"></div>
          <div>
            <dt class="text-2xl font-extrabold text-slate-900">{stats.quiz}</dt>
            <dd class="mt-0.5 text-xs font-medium text-slate-500">Quiz</dd>
          </div>
          <div class="h-10 w-px bg-slate-200"></div>
          <div>
            <dt class="text-2xl font-extrabold text-slate-900">3</dt>
            <dd class="mt-0.5 text-xs font-medium text-slate-500">Tingkat kelas</dd>
          </div>
        </dl>
      </div>

      <!-- KANAN -->
      <div class="relative">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-600 text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </div>
            <div>
              <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Quiz Event</div>
              <div class="font-bold text-slate-900">Uji kemampuanmu</div>
            </div>
          </div>
          <p class="mt-4 text-sm text-slate-600 leading-relaxed">
            Ikuti event quiz berjadwal dengan kode akses, kejar peringkat teratas di leaderboard.
          </p>
          <a href="/quiz/" class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 transition">
            Ikut Quiz
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/></svg>
            </div>
            <div class="mt-3 text-sm font-bold text-slate-900">Video pembahasan</div>
            <div class="mt-0.5 text-xs text-slate-500">Setiap materi ada videonya</div>
          </div>
          <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/></svg>
            </div>
            <div class="mt-3 text-sm font-bold text-slate-900">Nilai tersimpan</div>
            <div class="mt-0.5 text-xs text-slate-500">Hasil quiz tercatat otomatis</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
