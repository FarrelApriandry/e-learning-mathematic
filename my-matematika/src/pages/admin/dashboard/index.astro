---
import DashboardLayout from "../../../layouts/admin/DashboardLayout.astro";
import StatCard from "../../../components/dashboard/StatCard.jsx";
import MateriTable from "../../../components/layout/MateriTable";

// Drizzle (Neon Postgres)
import { getDb } from "../../../db/index.js";
import { sql } from "drizzle-orm";

// Statistik server-side — semuanya angka asli dari DB
let totalMateri = 0;
let totalQuiz = 0;
let totalUsers = 0;
let totalParticipants = 0;
let materiPerKelas = [
  { kelas: "X", jumlah: 0 },
  { kelas: "XI", jumlah: 0 },
  { kelas: "XII", jumlah: 0 },
];

try {
  const db = getDb();
  const [row] = await db.execute(sql`
    SELECT
      (SELECT count(*) FROM materi) AS total_materi,
      (SELECT count(*) FROM quiz_materi) + (SELECT count(*) FROM quiz_global) + (SELECT count(*) FROM quiz_event) AS total_quiz,
      (SELECT count(*) FROM users) AS total_users,
      (SELECT count(*) FROM quiz_participant) AS total_participants
  `);
  totalMateri = Number(row?.total_materi ?? 0);
  totalQuiz = Number(row?.total_quiz ?? 0);
  totalUsers = Number(row?.total_users ?? 0);
  totalParticipants = Number(row?.total_participants ?? 0);

  const kelasRows = await db.execute(sql`
    SELECT class, count(*) AS jumlah FROM materi GROUP BY class
  `);
  const byClass = {};
  for (const r of kelasRows) byClass[String(r.class)] = Number(r.jumlah);
  materiPerKelas = [
    { kelas: "X", jumlah: byClass["10"] ?? 0 },
    { kelas: "XI", jumlah: byClass["11"] ?? 0 },
    { kelas: "XII", jumlah: byClass["12"] ?? 0 },
  ];
} catch (err) {
  console.error("[Dashboard] Error fetching data:", err);
}

const maxKelas = Math.max(1, ...materiPerKelas.map((k) => k.jumlah));
---

<DashboardLayout title="Dashboard">
  <!-- Statistik utama -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <StatCard title="Total Materi" value={totalMateri} icon="book" tint="bg-indigo-50 text-indigo-600" />
    <StatCard title="Total Quiz" value={totalQuiz} icon="quiz" tint="bg-emerald-50 text-emerald-600" />
    <StatCard title="Peserta Quiz" value={totalParticipants} icon="participants" tint="bg-amber-50 text-amber-600" />
    <StatCard title="Akun Terdaftar" value={totalUsers} icon="users" tint="bg-slate-100 text-slate-600" />
  </div>

  <!-- Materi per kelas (data asli DB) -->
  <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-5">
    <div class="mb-4 flex items-center justify-between">
      <h3 class="text-base font-bold text-slate-900">Materi per Kelas</h3>
      <a href="/admin/materi/" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">
        Kelola materi
      </a>
    </div>
    <div class="space-y-3">
      {materiPerKelas.map((k) => (
        <div class="flex items-center gap-3">
          <span class="w-10 text-sm font-bold text-slate-700">Kls {k.kelas}</span>
          <div class="h-2.5 flex-1 overflow-hidden rounded-full bg-slate-100">
            <div
              class="h-full rounded-full bg-indigo-600"
              style={`width: ${(k.jumlah / maxKelas) * 100}%`}
            />
          </div>
          <span class="w-14 text-right text-sm font-semibold text-slate-700">
            {k.jumlah} materi
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- Daftar Materi -->
  <MateriTable client:load />
</DashboardLayout>
