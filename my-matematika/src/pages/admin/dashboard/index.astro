---
import DashboardLayout from "../../../layouts/admin/DashboardLayout.astro";
import StatCard from "../../../components/dashboard/StatCard.jsx";
import LineChart from "../../../components/charts/LineChart.jsx";
import MateriTable from "../../../components/layout/MateriTable";

// Firebase imports
import { db } from "../../../lib/firebaseConfig";
import { collection, getDocs } from "firebase/firestore";

// 🔹 Fetch Firestore data server-side
let totalMateri = 0;
let totalQuiz = 0;
let totalUsers = 0;
let recentActivities: any[] = [];

try {
  const materiSnap = await getDocs(collection(db, "materi"));
  totalMateri = materiSnap.size;

  const quizMateriSnap = await getDocs(collection(db, "quiz_materi"));
  const quizGlobalSnap = await getDocs(collection(db, "quiz_global"));
  const quizEventSnap = await getDocs(collection(db, "quiz_event"));
  totalQuiz = (quizMateriSnap.size) + (quizGlobalSnap.size) + (quizEventSnap.size) ;

  const userSnap = await getDocs(collection(db, "users"));
  totalUsers = userSnap.size;

  recentActivities = [
    {
      type: "quiz",
      title: "Siswa A menyelesaikan Quiz 1",
      color: "bg-blue-500",
      time: "10 menit yang lalu",
    },
    {
      type: "materi",
      title: "Materi \"Persamaan Linear\" ditambahkan",
      color: "bg-amber-400",
      time: "1 jam yang lalu",
    },
    {
      type: "event",
      title: "Event: Quiz Malam dibuka",
      color: "bg-green-500",
      time: "Kemarin",
    },
  ];
} catch (err) {
  console.error("[Dashboard] Error fetching data:", err);
}
---

<DashboardLayout title="Dashboard">
  <!-- Statistik utama -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <StatCard title="Total Materi" value={totalMateri} icon="book" color="bg-blue-500" />
    <StatCard title="Total Quiz" value={totalQuiz} icon="quiz" color="bg-green-500" />
    <StatCard title="Total Pengguna" value={totalUsers} icon="users" color="bg-purple-500" />
  </div>

  <!-- Aktivitas dan Chart -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-md">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">Aktivitas Pengguna (7 hari)</h3>
        <div class="text-sm text-slate-500">Realtime</div>
      </div>

      <LineChart
        client:load
        labels={["Sen", "Sel", "Rab", "Kam", "Jum", "Sab", "Min"]}
        data={[0, 0, 0, 0, 0, 0, 0]}
      />
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-md">
      <h3 class="text-lg font-semibold mb-4">Aktivitas Terbaru</h3>
      <ul class="space-y-3 text-sm text-slate-600">
        {recentActivities.map((act) => (
          <li class="flex items-start gap-3">
            <div class={`w-3 h-3 rounded-full ${act.color} mt-2`}></div>
            <div>
              <div class="font-medium">{act.title}</div>
              <div class="text-xs text-slate-400">{act.time}</div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Daftar Materi -->
  <MateriTable client:load />
</DashboardLayout>
