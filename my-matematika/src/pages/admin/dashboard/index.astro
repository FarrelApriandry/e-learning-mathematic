---
import DashboardLayout from "../../../layouts/admin/DashboardLayout.astro";
import StatCard from "../../../components/dashboard/StatCard.jsx";
import LineChart from "../../../components/charts/LineChart.jsx";
import MateriTable from "../../../components/layout/MateriTable";
---

<DashboardLayout title="Dashboard">

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <StatCard client:load title="Total Materi" value={42} icon="book" color="bg-blue-500" />
    <StatCard client:load title="Total Quiz" value={12} icon="quiz" color="bg-green-500" />
    <StatCard client:load title="Total Pengguna" value={230} icon="users" color="bg-purple-500" />
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-md">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold">Aktivitas Pengguna (7 hari)</h3>
        <div class="text-sm text-slate-500">Realtime</div>
      </div>

      <LineChart client:load labels={["Sen","Sel","Rab","Kam","Jum","Sab","Min"]} data={[12, 19, 8, 14, 20, 22, 18]} />
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-md">
      <h3 class="text-lg font-semibold mb-4">Aktivitas Terbaru</h3>
      <ul class="space-y-3 text-sm text-slate-600">
        <li class="flex items-start gap-3">
          <div class="w-3 h-3 rounded-full bg-blue-500 mt-2"></div>
          <div>
            <div class="font-medium">Siswa A menyelesaikan Quiz 1</div>
            <div class="text-xs text-slate-400">10 menit yang lalu</div>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <div class="w-3 h-3 rounded-full bg-amber-400 mt-2"></div>
          <div>
            <div class="font-medium">Materi "Persamaan" ditambahkan</div>
            <div class="text-xs text-slate-400">1 jam yang lalu</div>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <div class="w-3 h-3 rounded-full bg-green-500 mt-2"></div>
          <div>
            <div class="font-medium">Event: Quiz Malam dibuka</div>
            <div class="text-xs text-slate-400">Kemarin</div>
          </div>
        </li>
      </ul>
    </div>
  </div>

  <!-- 🔽 Tambahkan ini di bawah semua konten utama -->
  <MateriTable client:load />

</DashboardLayout>
