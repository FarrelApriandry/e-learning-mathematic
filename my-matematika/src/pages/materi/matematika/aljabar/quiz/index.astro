---
import MainLayout from "../../../../../layouts/MainLayout.astro";
const levels = [1,2,3,4,5];
---
<MainLayout title="Pilih Level - Aljabar">
  <section class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-4">Pilih Level Quiz</h1>
    <div class="grid sm:grid-cols-5 gap-4">
      {levels.map(l=>(
        <a href={`./quiz/${l}`} class="card text-center p-6">
          <div class="text-lg font-bold">Level {l}</div>
          <div class="text-xs text-slate-500 mt-2">Kesulitan meningkat</div>
        </a>
      ))}
    </div>
  </section>
</MainLayout>
