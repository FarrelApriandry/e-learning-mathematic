---
import MainLayout from "../../../../layouts/MainLayout.astro";
import MateriList from "../../../../components/public/layout/MateriList.jsx";

const KELAS = { "10": "X", "11": "XI", "12": "XII" };
const k = "10";
---
<MainLayout title={`Materi Kelas ${KELAS[k]}`}>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="container mx-auto px-4 md:px-6 py-10">
      <nav class="flex items-center gap-1.5 text-xs font-semibold text-slate-400">
        <a href="/materi/" class="hover:text-indigo-600 transition">Materi</a>
        <span>/</span>
        <span class="text-slate-700">Kelas {KELAS[k]}</span>
      </nav>
      <h1 class="mt-3 text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900">Materi Kelas {KELAS[k]}</h1>
      <p class="mt-2 max-w-2xl text-sm md:text-base text-slate-600">Video pembahasan dan ringkasan materi matematika kelas {KELAS[k]} SMA.</p>
      <div class="mt-5 flex gap-2">
        {["10", "11", "12"].map((c) => (
          <a
            href={`/materi/kelas/${c}/`}
            class={c === k
              ? "rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white"
              : "rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:border-slate-400 transition"}
          >
            Kelas {KELAS[c]}
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="container mx-auto px-4 md:px-6 py-10">
    <MateriList client:load kelas="10" />
  </section>
</MainLayout>
