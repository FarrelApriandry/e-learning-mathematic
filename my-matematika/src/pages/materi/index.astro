---
// src/pages/sma/kelas/index.astro
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Pilih Kelas SMA">
    <section class="container mx-auto px-4 py-12">
        <h1 class="text-3xl font-bold text-center mb-10">Pilih Kelasmu</h1>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Kelas X -->
        <a href="/materi/kelas/10/" class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300">
            <div class="flex flex-col items-center text-center">
            <h2 class="text-xl font-semibold mb-1">Kelas X</h2>
            <p class="text-gray-500 text-sm mb-4">Pelajari materi dasar dan konsep awal.</p>
            <span class="inline-flex items-center gap-2 text-indigo-600 font-medium group-hover:translate-x-1 transition-transform">
                Lihat Materi →
            </span>
            </div>
        </a>

        <!-- Kelas XI -->
        <a href="/materi/kelas/11/" class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300">
            <div class="flex flex-col items-center text-center">
            <h2 class="text-xl font-semibold mb-1">Kelas XI</h2>
            <p class="text-gray-500 text-sm mb-4">Materi lanjutan dan analisis konsep.</p>
            <span class="inline-flex items-center gap-2 text-indigo-600 font-medium group-hover:translate-x-1 transition-transform">
                Lihat Materi →
            </span>
            </div>
        </a>

        <!-- Kelas XII -->
        <a href="/materi/kelas/12/" class="group bg-white rounded-2xl p-6 shadow-md hover:shadow-xl transition-all duration-300">
            <div class="flex flex-col items-center text-center">
            <h2 class="text-xl font-semibold mb-1">Kelas XII</h2>
            <p class="text-gray-500 text-sm mb-4">Materi persiapan ujian dan pendalaman.</p>
            <span class="inline-flex items-center gap-2 text-indigo-600 font-medium group-hover:translate-x-1 transition-transform">
                Lihat Materi →
            </span>
            </div>
        </a>
        </div>
    </section>
</MainLayout>
