---
import MainLayout from "../../../../layouts/MainLayout.astro";
---

<MainLayout title="Aljabar - Kelas 10">
  <section class="max-w-4xl mx-auto py-10 px-4">
    <h1 class="text-3xl font-bold text-indigo-700 mb-6 animate-fadeIn">Materi Aljabar</h1>

    <div class="rounded-2xl overflow-hidden shadow-lg mb-8">
      <iframe
        class="w-full aspect-video"
        src="https://www.youtube.com/embed/NIs8mJMRhfE"
        title="Video Pembelajaran Aljabar"
        allowfullscreen
      ></iframe>
    </div>

    <div class="text-center mt-6 animate-slideUp">
      <button class="bg-indigo-600 text-white px-8 py-3 rounded-full hover:bg-indigo-700 shadow-lg transition">
        Mulai Quiz ➜
      </button>
    </div>
  </section>
</MainLayout>