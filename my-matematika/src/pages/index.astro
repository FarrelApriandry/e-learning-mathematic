---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
---
<MainLayout title="Beranda">
  <Hero 
    heading="Asyik Math" 
    second_heading="E-Learning"
    sub="Video pembelajaran + quiz interaktif — fokus ke pemahaman, bukan hafalan." 
    ctaText="Mulai Sekarang" 
    ctaHref="/sma/matematika" 
  />

  <!-- Feature strip -->
  <section class="container mx-auto px-4 py-8">
    <div class="grid md:grid-cols-3 gap-6">
      <div class="card p-6">
        <div class="text-sm text-amber-400 font-semibold">Video</div>
        <h3 class="mt-3 text-lg font-bold">Pembelajaran Visual</h3>
        <p class="mt-2 text-slate-600 text-sm">Setiap topik ditemani video singkat yang mudah dipahami.</p>
      </div>

      <div class="card p-6">
        <div class="text-sm text-amber-400 font-semibold">Quiz</div>
        <h3 class="mt-3 text-lg font-bold">Level 1 - 5</h3>
        <p class="mt-2 text-slate-600 text-sm">Nilai dan progress tersimpan (nanti via Firebase).</p>
      </div>

      <div class="card p-6">
        <div class="text-sm text-amber-400 font-semibold">Praktis</div>
        <h3 class="mt-3 text-lg font-bold">Ringkas & Fokus</h3>
        <p class="mt-2 text-slate-600 text-sm">Materi diringkas supaya efisien untuk presentasi tugas.</p>
      </div>
    </div>
  </section>

  <!-- Quick links to kelas (preview) -->
  <section class="container mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-2xl font-bold">Pilih Kelas</h2>
      <a href="/sma/matematika" class="text-sm text-slate-500 hover:text-slate-800">Lihat Semua →</a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/sma/matematika/aljabar" class="card p-6 flex flex-col justify-between">
        <div>
          <div class="text-sm text-amber-400">Kelas 10</div>
          <div class="mt-2 text-lg font-semibold">Aljabar — Persamaan</div>
          <p class="text-sm text-slate-600 mt-2">Ringkas & visual, + quiz level 1</p>
        </div>
        <div class="mt-4 self-end">
          <span class="text-xs text-slate-500">Durasi video: 3–5 menit</span>
        </div>
      </a>

      <a href="/sma/matematika/geometri" class="card p-6 flex flex-col justify-between">
        <div>
          <div class="text-sm text-amber-400">Kelas 10</div>
          <div class="mt-2 text-lg font-semibold">Geometri — Bangun Datar</div>
          <p class="text-sm text-slate-600 mt-2">Visual & praktik soal</p>
        </div>
        <div class="mt-4 self-end">
          <span class="text-xs text-slate-500">Durasi video: 3–6 menit</span>
        </div>
      </a>

      <a href="/sma/matematika/trigonometri" class="card p-6 flex flex-col justify-between">
        <div>
          <div class="text-sm text-amber-400">Kelas 11</div>
          <div class="mt-2 text-lg font-semibold">Trigonometri — Dasar</div>
          <p class="text-sm text-slate-600 mt-2">Konsep + contoh</p>
        </div>
        <div class="mt-4 self-end">
          <span class="text-xs text-slate-500">Durasi video: 4–7 menit</span>
        </div>
      </a>
    </div>
  </section>
</MainLayout>
