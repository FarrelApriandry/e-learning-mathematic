---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Kontak Kami">
  <section class="container mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-6">Hubungi Kami</h1>

    <p class="text-slate-600 mb-6">
      Punya pertanyaan, saran, atau ingin berkolaborasi? Kirim pesan melalui form di bawah.
    </p>

    <form class="grid gap-5 max-w-md">
      <input type="text" placeholder="Nama" class=" px-2 py-1 input border rounded border-slate-900/5" required />
      <input type="email" placeholder="Email" class=" px-2 py-1 input border rounded border-slate-900/5" required />
      <textarea placeholder="Pesan" rows="4" class=" px-2 py-1 input border rounded border-slate-900/5" required></textarea>
      <button type="submit" class="btn-primary w-full">Kirim</button>
    </form>
  </section>
</MainLayout>
