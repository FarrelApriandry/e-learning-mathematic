# ===========================================
# E-Learning Matematika — Environment Variables
# Salin file ini jadi .env lalu isi nilainya.
# ===========================================

# --- Database (Neon Postgres) ---
# Ambil dari Neon Console -> Project -> Connection String.
# Untuk serverless (Vercel), pakai endpoint "pooled" (berakhiran -pooler).
DATABASE_URL=postgres://user:password@ep-cool-name-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- App ---
PUBLIC_BASE_URL=http://localhost:4321
